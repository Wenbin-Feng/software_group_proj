{
  "name": "folio-group-project",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "dev:api": "node --env-file=.env --import tsx --watch apps/api/src/server.ts",
    "check": "npm run check -w apps/web && npm run check -w apps/api",
    "test": "npm run test -w apps/api && node --test apps/web/tests/*.test.js",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "db:migrate": "node --env-file=.env --import tsx apps/api/src/migrate.ts",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0"
  },
  "overrides": {
    "pptxgenjs": {
      "image-size": "2.0.4"
    }
  }
}
