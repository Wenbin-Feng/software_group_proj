# Local backend. Production values belong only in /srv/folio/server.env.
NODE_ENV=development
PORT=3001
DATA_DIR=./.data
APP_PUBLIC_URL=http://127.0.0.1:5173
# Must be the same random value in Vercel's ORIGIN_SECRET and server.env.
# Required in production; never prefix secrets with VITE_.
ORIGIN_SECRET=
H2A_LLM_BASE_URL=https://openrouter.ai/api/v1
H2A_LLM_API_KEY=
H2A_LLM_MODEL=qwen/qwen3.6-plus
# Disable extra reasoning for responsive chat and structured courseware.
H2A_REASONING_EFFORT=none
H2A_DAILY_CHAT_LIMIT=60
H2A_DAILY_GENERATION_LIMIT=10
