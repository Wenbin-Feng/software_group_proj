# Local backend. Production values belong only in /srv/folio/server.env.
NODE_ENV=development
PORT=3001
DATA_DIR=./.data
APP_PUBLIC_URL=http://127.0.0.1:5173
# Must be the same random value in Vercel's ORIGIN_SECRET and server.env.
# Required in production; never prefix secrets with VITE_.
ORIGIN_SECRET=
H2A_LLM_BASE_URL=https://openrouter.ai/api/v1
H2A_LLM_API_KEY=
H2A_LLM_MODEL=deepseek/deepseek-v4.1-flash-1017
# Disable extra reasoning for responsive chat and structured courseware.
H2A_REASONING_EFFORT=none
H2A_DAILY_CHAT_LIMIT=60
H2A_DAILY_GENERATION_LIMIT=10
# Optional backend-only Langfuse Cloud observability. Leave keys empty to disable.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
# Set false to disable tracing even when keys are configured.
LANGFUSE_ENABLED=true
# Optional Google login. Backend only; production callback must match Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Callback is APP_PUBLIC_URL + /api/auth/google/callback.
